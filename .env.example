# Copia este archivo como .env y llena tus datos. NUNCA subas .env a GitHub.

# Tradier: https://dash.tradier.com/settings/api
TRADIER_TOKEN=pon_tu_token_aqui
# "sandbox" para practicar, "live" para datos/cuenta real
TRADIER_ENV=sandbox
TRADIER_ACCOUNT_ID=

# Polygon.io (historial para backtest): https://polygon.io/dashboard/keys
POLYGON_API_KEY=

# Interactive Brokers PAPER (TWS: 7497, IB Gateway: 4002). El sistema rechaza cuentas reales.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=7

# Telegram: crea un bot con @BotFather y obtén tu chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gestión de riesgo
ACCOUNT_SIZE=8000
RISK_PER_TRADE_PCT=1.0
# Si la opción pierde este % de la prima, se sale (stop de la opción)
OPTION_STOP_PCT=30
